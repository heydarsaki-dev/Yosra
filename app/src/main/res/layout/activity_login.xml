<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="center"
        android:background="@drawable/avatar_glass"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher"
        android:elevation="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:text="یسرا"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/purple"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="6dp"
        android:text="به یسرا خوش اومدی 👋"
        android:textSize="15sp"
        android:textColor="@color/textDark"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="برای همگام‌سازی داده‌هات با داشبورد، رمز ورود رو وارد کن. فقط یک بار پرسیده می‌شه و برای همیشه ذخیره می‌شه."
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/textGray"/>

    <EditText
        android:id="@+id/login_pw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:layout_marginTop="26dp"
        android:hint="رمز ورود"
        android:gravity="right|center_vertical"
        android:inputType="textPassword"
        android:textSize="14sp"
        android:background="@drawable/card"
        android:padding="15dp"
        android:imeOptions="actionGo"/>

    <TextView
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:background="@drawable/btn_primary"
        android:padding="15dp"
        android:text="ورود"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4" />

</LinearLayout>
