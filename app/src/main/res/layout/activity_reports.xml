<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="72dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="30dp"
                android:paddingBottom="12dp"
                android:text="گزارش‌ها 📊"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/textDark"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:id="@+id/r_mode_month"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/chip_on"
                    android:padding="10dp"
                    android:text="ماهانه 📆"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple"/>
                <TextView
                    android:id="@+id/r_mode_day"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:background="@drawable/chip"
                    android:padding="10dp"
                    android:text="روزانه 📅"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/textGray"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/card"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btn_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_soft"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="‹ قبلی"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple"/>
                <TextView
                    android:id="@+id/tv_period"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="مهر ۱۴۰۴"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/textDark"/>
                <TextView
                    android:id="@+id/btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_soft"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="بعدی ›"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:elevation="5dp"
                android:padding="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="درآمد"
                            android:textSize="11sp"
                            android:textColor="@color/textGray"/>
                        <TextView
                            android:id="@+id/r_income"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="۰"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/green"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="خرج"
                            android:textSize="11sp"
                            android:textColor="@color/textGray"/>
                        <TextView
                            android:id="@+id/r_expense"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="۰"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/red"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="مانده"
                            android:textSize="11sp"
                            android:textColor="@color/textGray"/>
                        <TextView
                            android:id="@+id/r_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="۰"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/purple"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/r_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/count_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="۰ تراکنش"
                    android:textSize="12sp"
                    android:textColor="@color/textGray"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/trend_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:elevation="5dp"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="روند روزانه 📈"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/textDark"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="🟢 درآمد   🔴 خرج"
                    android:textSize="11sp"
                    android:textColor="@color/textGray"/>
                <ir.yosra.app.BarChartView
                    android:id="@+id/bar_view"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/donut_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="درآمد به تفکیک دسته 🍩"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textDark"/>
                <TextView
                    android:id="@+id/donut_chip_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_on"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="درآمد 💰"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/green"/>
                <TextView
                    android:id="@+id/donut_chip_out"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/chip"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="خرج 🧾"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/textGray"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/card"
                android:elevation="5dp"
                android:orientation="vertical"
                android:padding="16dp">
                <ir.yosra.app.DonutChartView
                    android:id="@+id/donut_view"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_gravity="center_horizontal"/>
                <LinearLayout
                    android:id="@+id/cat_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"/>
                <TextView
                    android:id="@+id/cat_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="هنوز خرجی ثبت نشده"
                    android:textSize="12sp"
                    android:textColor="@color/textGray"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/member_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="چه کسی درآمد داشت؟"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textDark"/>
                <TextView
                    android:id="@+id/member_chip_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_on"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="درآمد 💰"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/green"/>
                <TextView
                    android:id="@+id/member_chip_out"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/chip"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="خرج 🧾"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/textGray"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/member_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingBottom="8dp"/>

            <LinearLayout
                android:id="@+id/day_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:text="تراکنش‌های این روز 📜"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textDark"/>
                <LinearLayout
                    android:id="@+id/tx_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <TextView
                    android:id="@+id/tx_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="در این روز تراکنشی نیست"
                    android:textSize="12sp"
                    android:textColor="@color/textGray"
                    android:visibility="gone"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/nav"
        layout="@layout/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"/>
</FrameLayout>
