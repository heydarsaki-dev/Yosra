<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:orientation="horizontal"
    android:background="@color/white"
    android:elevation="10dp"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <ImageView
            android:id="@+id/nav_home_ic"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:src="@drawable/ic_nav_home"/>
        <TextView
            android:id="@+id/nav_home_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="خانه"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_trans"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <ImageView
            android:id="@+id/nav_trans_ic"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:src="@drawable/ic_nav_trans"/>
        <TextView
            android:id="@+id/nav_trans_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="تراکنش‌ها"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_report"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <ImageView
            android:id="@+id/nav_report_ic"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:src="@drawable/ic_nav_report"/>
        <TextView
            android:id="@+id/nav_report_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="گزارش"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_settings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <ImageView
            android:id="@+id/nav_settings_ic"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:src="@drawable/ic_nav_settings"/>
        <TextView
            android:id="@+id/nav_settings_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="تنظیمات"
            android:textSize="10sp"/>
    </LinearLayout>
</LinearLayout>
