<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="72dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_header"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="34dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/home_logo"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/avatar_glass"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_greet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="سلام حیدر 👋"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                        android:text="به یسرا خوش اومدی 🌸"
                        android:textSize="13sp"
                        android:textColor="#C9C2FF"/>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_settings"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_nav_settings"
                        android:tint="@color/white"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:background="@drawable/card"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="درآمد ماه"
                            android:textSize="11sp"
                            android:textColor="@color/textGray"/>
                        <TextView
                            android:id="@+id/tv_m_income"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="۰"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/green"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="خرج ماه"
                            android:textSize="11sp"
                            android:textColor="@color/textGray"/>
                        <TextView
                            android:id="@+id/tv_m_expense"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="۰"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/red"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="موجودی"
                            android:textSize="11sp"
                            android:textColor="@color/textGray"/>
                        <TextView
                            android:id="@+id/tv_m_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="۰"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/purple"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/tile_mint"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💰 درآمد امروز"
                        android:textSize="12sp"
                        android:textColor="@color/textGray"/>
                    <TextView
                        android:id="@+id/tv_today_snapp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="۰ تومان"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/textDark"/>
                    <TextView
                        android:id="@+id/btn_snapp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/btn_ghost"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:gravity="center"
                        android:text="＋ ثبت سریع"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/green"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/tile_rose"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧾 خرج امروز"
                        android:textSize="12sp"
                        android:textColor="@color/textGray"/>
                    <TextView
                        android:id="@+id/tv_today_exp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="۰ تومان"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/textDark"/>
                    <TextView
                        android:id="@+id/btn_expense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/btn_ghost"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:gravity="center"
                        android:text="＋ ثبت خرج"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/red"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_inst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card"
                android:elevation="5dp"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💳 بدهی‌ها"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/textDark"/>
                    <TextView
                        android:id="@+id/tv_inst_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="بدهی ثبت نشده"
                        android:textSize="12sp"
                        android:textColor="@color/textGray"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_soft"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:gravity="center"
                    android:text="مدیریت ←"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="6dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="آخرین تراکنش‌ها"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textDark"/>
                <TextView
                    android:id="@+id/btn_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="همه ←"
                    android:textSize="13sp"
                    android:textColor="@color/purple"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="4dp"
                android:text="💡 برای تغییر ترتیب، ⠿ را نگه دار و بکش ↔️"
                android:textSize="11sp"
                android:textColor="@color/textGray"/>

            <LinearLayout
                android:id="@+id/latest_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"/>

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="30dp"
                android:text="هنوز تراکنشی ثبت نشده 🙁\nاز دکمه‌های بالا شروع کن!"
                android:textSize="13sp"
                android:textColor="@color/textGray"
                android:lineSpacingExtra="6dp"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/nav"
        layout="@layout/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"/>
</FrameLayout>
